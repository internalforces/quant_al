[Unit]
Description=MB Quant FastAPI
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/mb-quant
EnvironmentFile=-/var/www/mb-quant/.env
Environment=MB_QUANT_TRUST_PROXY_HEADERS=true
ExecStart=/var/www/mb-quant/.venv-web/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
