[Unit]
Description=MB Quant FastAPI Standalone
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/mb-quant
EnvironmentFile=-/var/www/mb-quant/.env
ExecStart=/var/www/mb-quant/.venv-web/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
