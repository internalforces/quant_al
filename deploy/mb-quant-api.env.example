# Settings read by the public FastAPI service only. Copy this file to .env.api
# in the project root; do not put unrelated Telegram or mail credentials here.
MB_QUANT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MB_QUANT_REQUESTS_PER_MINUTE=30
MB_QUANT_TRUST_PROXY_HEADERS=false
# Required only when the Telegram bot is enabled. It must match the bot's value.
MB_QUANT_BOT_API_TOKEN=
