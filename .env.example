# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-new-bot-token

# Optional: comma-separated Telegram chat IDs allowed to use the bot.
# Leave empty to allow every chat that can access the bot.
# Use /whoami in the bot to check a private or group chat_id.
TELEGRAM_ALLOWED_CHAT_IDS=

# MB Quant API base URL used by the Telegram bot.
# Local/systemd example:
MB_QUANT_API_BASE_URL=http://127.0.0.1:8000/api
# Docker compose bot profile uses this instead:
# MB_QUANT_API_BASE_URL=http://mb-quant-web:8000/api

# SQLite file used by the bot to store per-chat aliases.
TELEGRAM_ALIAS_DB_PATH=/var/www/mb-quant/data/telegram_aliases.sqlite3

# Optional: API timeout in seconds for price/signal requests.
MB_QUANT_API_TIMEOUT=90

# Public API safeguards. The deployed React app uses same-origin /api requests,
# so no production origin is needed unless a separate browser client calls the API.
MB_QUANT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MB_QUANT_REQUESTS_PER_MINUTE=30
# Set to true only when every API request is proxied through a trusted reverse proxy.
MB_QUANT_TRUST_PROXY_HEADERS=false

# Scheduled signal email job. Use 587 for STARTTLS or 465 for SSL.
EMAIL_SENDER=
EMAIL_RECIPIENTS=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
